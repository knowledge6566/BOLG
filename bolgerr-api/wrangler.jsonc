{
  "name": "bolgerr-api",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs",
      "database_id": "bd6caeb5-b44e-4529-91d5-0ecb846d9cbd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "POSTS_CACHE",
      "id": "b10196cdffa94ca48f75c727c60858f1"
    }
  ],
  "triggers": {
    "crons": ["30 3 * * *", "30 13 * * *"]
  },
  "vars": {
               "BLOG_CATEGORIES": "Technology,Design,Culture,Science,Life,Business,Entertainment",
    "TOPIC_FOCUS": "technology, design, culture, science, everyday life, business, entertainment, movies and music",
   "BLOG_AUTHOR": "Nishu Blogs"
  },
  "observability": {
    "enabled": true
  }
}