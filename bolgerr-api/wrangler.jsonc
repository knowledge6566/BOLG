{
  "name": "bolgerr-api",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs",
      "database_id": "bd6caeb5-b44e-4529-91d5-0ecb846d9cbd"
    }
  ],
  "triggers": {
    "crons": ["30 3 * * *", "30 13 * * *"]
  },
  "vars": {
    "BLOG_CATEGORIES": "Technology,Design,Culture,Science,Life,Business",
    "ARTICLE_WORDS": "1200",
    "BLOG_AUTHOR": "Bolgerr "
  },
  "observability": {
    "enabled": true
  }
}